    {
      "parameters": {
        "jsCode": "const row = $json;\nconst lineNumber = row.Line ?? row.lineNumber ?? '';\nconst originalLine = row['Script Line'] ?? row.Script ?? row.originalLine ?? '';\nif (!String(originalLine).trim()) return [];\nreturn [{json:{lineNumber:Number(lineNumber)||0,originalLine:String(originalLine).trim(),fullScriptContext:String(originalLine).trim()}}];"
      },
      "id": "ca122c66-2e37-4b2d-823e-2b6215a58342",
      "name": "Prepare Current Line",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2592,
        528
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "YOUR-API-KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    contents: [\n      {\n        parts: [\n          {\n            text:\n`You are an expert video research assistant.\n\nYou will receive ONE sentence from a video script.\n\nSCRIPT LINE:\n${$json.originalLine}\n\nYour job is to understand exactly what this sentence means and determine what real-world YouTube footage would best illustrate it.\n\nReturn ONLY valid JSON in this exact format:\n\n{\n  \"meaning\": \"Brief explanation of what the sentence means.\",\n  \"visualNeeded\": \"Describe the exact footage needed to represent this sentence.\",\n  \"searchQuery\": \"A highly specific YouTube search query for finding the best matching footage.\",\n  \"confidence\": 0\n}\n\nRules:\n1. Understand the actual meaning before creating the search query.\n2. Never use a generic search query when a specific query is possible.\n3. If a person, athlete, celebrity, team, company, event, location, vehicle, race, incident, or organization is mentioned, include its exact name.\n4. Prefer real footage, news footage, interviews, press conferences, races, matches, events, and documentary footage.\n5. Do not use generic stock footage unless the sentence is genuinely generic.\n6. Do not invent facts.\n7. confidence must be an integer from 0 to 10.\n8. Return JSON only. No markdown. No explanation outside the JSON.`\n          }\n        ]\n      }\n    ],\n    generationConfig: {\n      temperature: 0.2,\n      responseMimeType: \"application/json\"\n    }\n  }\n}}",
        "options": {}
      },
      "id": "9da66e3f-98c2-4ef0-9f33-bf34d53c1246",
      "name": "Gemini - Analyze Line",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2352,
        528
      ]
    },
    {
      "parameters": {
        "jsCode": "const p=$('Prepare Current Line').item.json; const t=$json.candidates?.[0]?.content?.parts?.[0]?.text||''; let a; try{a=JSON.parse(t.replace(/```json|```/g,'').trim())}catch(e){a={meaning:'',visualNeeded:'',searchQuery:p.originalLine,confidence:0}} return [{json:{...p,meaning:a.meaning||'',visualNeeded:a.visualNeeded||'',searchQuery:a.searchQuery||p.originalLine,confidence:Number(a.confidence)||0}}];"
      },
