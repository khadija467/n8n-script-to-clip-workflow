    {
      "parameters": {
        "jsCode": "const p=$('Parse Gemini Result').item.json; const r=$json.items||[]; if(!r.length)return [{json:{...p,videoTitle:'',youtubeUrl:'',timestamp:'',finalClipUrl:'',source:'No suitable YouTube result',noResults:true}}]; const v=r[0],id=v.id?.videoId||''; return [{json:{...p,videoTitle:v.snippet?.title||'',youtubeUrl:id?`https://www.youtube.com/watch?v=${id}`:'',timestamp:'',finalClipUrl:id?`https://www.youtube.com/watch?v=${id}`:'',source:id?'YouTube search':'No suitable YouTube result',noResults:!id}}];"
      },
